{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/receipt.schema.json",
  "title": "Device capture receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint",
    "envelope",
    "rows",
    "cols",
    "captured_at",
    "device_key_id",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "fingerprint": { "$ref": "fingerprint.schema.json" },
    "envelope": { "$ref": "envelope.schema.json" },
    "rows": { "const": 1024 },
    "cols": { "const": 512 },
    "captured_at": { "type": "string", "format": "date-time" },
    "device_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature_algorithm": { "const": "ecdsa-p256-sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
