{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/envelope.schema.json",
  "title": "ZKLP location envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "field", "encoding", "value"],
  "properties": {
    "schema_version": { "const": 1 },
    "algorithm": { "const": "mimc-bn254" },
    "field": { "const": "bn254-scalar" },
    "encoding": { "const": "f32-radians-ieee754-bits+salt-field" },
    "value": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
