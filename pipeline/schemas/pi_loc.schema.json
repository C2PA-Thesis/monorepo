{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/pi_loc.schema.json",
  "title": "ZKLP Groth16 location proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_system",
    "curve",
    "proof",
    "public_inputs",
    "parameters"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proof_system": { "const": "groth16" },
    "curve": { "const": "bn254" },
    "proof": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "public_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "region"],
      "properties": {
        "envelope": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "region": { "$ref": "#/$defs/public_region" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "r1cs_sha256", "verifying_key_sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "r1cs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifying_key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "public_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "face", "i", "j", "k"],
      "properties": {
        "resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
        "face": { "type": "integer", "minimum": 0, "maximum": 19 },
        "i": { "type": "integer" },
        "j": { "type": "integer" },
        "k": { "type": "integer" }
      }
    }
  }
}
