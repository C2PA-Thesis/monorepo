{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/secrets.schema.json",
  "title": "Private ZKLP witness inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_path",
    "latitude_degrees",
    "longitude_degrees",
    "salt",
    "captured_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "latitude_degrees": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude_degrees": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "salt": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "captured_at": { "type": "string", "format": "date-time" }
  }
}
