{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/pi_img-bundle.schema.json",
  "title": "Inline HyperVerITAS PST proof bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "members"],
  "properties": {
    "schema_version": { "const": 1 },
    "metadata": { "$ref": "pi_img-metadata.schema.json" },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof.bin"],
      "properties": {
        "proof.bin": { "$ref": "#/$defs/member" }
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data", "sha256", "bytes"],
      "properties": {
        "encoding": { "const": "base64" },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
