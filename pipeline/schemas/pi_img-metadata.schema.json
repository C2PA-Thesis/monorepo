{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utdt.edu/td8/zkloc/v1/pi_img-metadata.schema.json",
  "title": "HyperVerITAS PST crop proof metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "size", "original", "crop", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "hyperveritas-pst-crop-v1" },
    "size": { "const": 19 },
    "original": { "$ref": "#/$defs/dimensions" },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_row", "start_col", "end_row", "end_col"],
      "properties": {
        "start_row": { "const": 0 },
        "start_col": { "const": 0 },
        "end_row": { "const": 512 },
        "end_col": { "const": 512 }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof.bin"],
      "properties": {
        "proof.bin": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": { "const": 1024 },
        "cols": { "const": 512 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
